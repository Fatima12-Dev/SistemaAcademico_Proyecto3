@model Periodo
@{
    ViewData["Title"] = "Editar Periodo";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <div class="page-header-icon warning">
            <i class="bi bi-pencil-square"></i>
        </div>
        <div>
            <nav class="breadcrumb-nav">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <span class="separator">/</span>
                <a asp-controller="Periodo" asp-action="Index">Periodos</a>
                <span class="separator">/</span>
                <span>Editar</span>
            </nav>
            <h1 class="page-title">Editar Periodo</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="sa-card">
            <div class="sa-card-header">
                <span style="font-weight: 600; font-size: 0.9375rem;">Datos del Periodo</span>
                <span class="font-mono text-tertiary" style="font-size: 0.8125rem;">ID: @Model.id_periodo</span>
            </div>
            <div class="sa-card-body sa-form">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger" style="font-size: 0.875rem;"></div>
                    <input type="hidden" asp-for="id_periodo" />
                    <div class="mb-3">
                        <label asp-for="nombrePeriodo" class="form-label">Nombre del Periodo</label>
                        <input asp-for="nombrePeriodo" class="form-control" />
                        <span asp-validation-for="nombrePeriodo" class="text-danger" style="font-size: 0.8125rem;"></span>
                    </div>
                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn-brand">
                            <i class="bi bi-check-lg"></i> Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn-ghost">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
