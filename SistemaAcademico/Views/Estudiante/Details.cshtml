@model Estudiante
@{
    ViewData["Title"] = "Detalles del Estudiante";
}

<h2>Detalles del Estudiante</h2>
<hr />

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.id_estudiante</dd>

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.nombreEstudiante</dd>

    <dt class="col-sm-3">Carnet</dt>
    <dd class="col-sm-9">@Model.carnet</dd>
</dl>

<div>
    <a asp-action="Edit" asp-route-id="@Model.id_estudiante" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
