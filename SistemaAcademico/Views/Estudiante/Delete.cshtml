@model Estudiante
@{
    ViewData["Title"] = "Eliminar Estudiante";
}

<h2>Eliminar Estudiante</h2>
<h4 class="text-danger">Esta seguro que desea eliminar este estudiante?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.id_estudiante</dd>

    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.nombreEstudiante</dd>

    <dt class="col-sm-3">Carnet</dt>
    <dd class="col-sm-9">@Model.carnet</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="id_estudiante" />
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</form>
