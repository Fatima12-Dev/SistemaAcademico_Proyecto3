@model Curso
@{
    ViewData["Title"] = "Eliminar Curso";
}

<h2>Eliminar Curso</h2>
<h4 class="text-danger">Esta seguro que desea eliminar este curso?</h4>
<hr />

<dl class="row">
    <dt class="col-sm-3">ID</dt>
    <dd class="col-sm-9">@Model.id_curso</dd>

    <dt class="col-sm-3">Nombre del Curso</dt>
    <dd class="col-sm-9">@Model.nombreCurso</dd>

    <dt class="col-sm-3">Seccion</dt>
    <dd class="col-sm-9">@Model.seccion</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="id_curso" />
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</form>
