@model Curso
@{
    ViewData["Title"] = "Crear Curso";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <div class="page-header-icon info">
            <i class="bi bi-journal-plus"></i>
        </div>
        <div>
            <nav class="breadcrumb-nav">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <span class="separator">/</span>
                <a asp-controller="Curso" asp-action="Index">Cursos</a>
                <span class="separator">/</span>
                <span>Crear</span>
            </nav>
            <h1 class="page-title">Nuevo Curso</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="sa-card">
            <div class="sa-card-header">
                <span style="font-weight: 600; font-size: 0.9375rem;">Datos del Curso</span>
            </div>
            <div class="sa-card-body sa-form">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger" style="font-size: 0.875rem;"></div>
                    <div class="mb-3">
                        <label asp-for="nombreCurso" class="form-label">Nombre del Curso</label>
                        <input asp-for="nombreCurso" class="form-control" placeholder="Ej: Desarrollo Web Activo" />
                        <span asp-validation-for="nombreCurso" class="text-danger" style="font-size: 0.8125rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="seccion" class="form-label">Seccion</label>
                        <input asp-for="seccion" class="form-control" placeholder="Ej: A" />
                        <span asp-validation-for="seccion" class="text-danger" style="font-size: 0.8125rem;"></span>
                    </div>
                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn-brand">
                            <i class="bi bi-check-lg"></i> Crear Curso
                        </button>
                        <a asp-action="Index" class="btn-ghost">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
