@model SistemaAcademico.Models.ViewModels.NotaViewModel
@{
    ViewData["Title"] = "Editar Nota";
}

<!-- Alerts -->
@if (TempData["Error"] != null)
{
    <div class="sa-alert danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-left">
        <div class="page-header-icon success">
            <i class="bi bi-pencil-square"></i>
        </div>
        <div>
            <nav class="breadcrumb-nav">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <span class="separator">/</span>
                <a asp-controller="Nota" asp-action="Index">Notas</a>
                <span class="separator">/</span>
                <span>Editar</span>
            </nav>
            <h1 class="page-title">Editar Nota</h1>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="sa-card">
            <div class="sa-card-header">
                <span style="font-weight: 600; font-size: 0.9375rem;">Calificaciones</span>
                <span class="font-mono text-tertiary" style="font-size: 0.8125rem;">ID: @Model.Nota.id_nota</span>
            </div>
            <div class="sa-card-body sa-form">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger" style="font-size: 0.875rem;"></div>
                    <input type="hidden" asp-for="Nota.id_nota" />
                    <input type="hidden" asp-for="Nota.fechaRegistro" />

                    <div class="mb-3">
                        <label class="form-label">Matricula (Estudiante - Curso)</label>
                        <select asp-for="Nota.id_matricula" asp-items="Model.Matriculas" class="form-select">
                            <option value="">-- Seleccionar Matricula --</option>
                        </select>
                        <span asp-validation-for="Nota.id_matricula" class="text-danger" style="font-size: 0.8125rem;"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Nota.nota1" class="form-label">Nota 1 (30%)</label>
                            <input asp-for="Nota.nota1" class="form-control nota-input" type="number" step="0.01" min="0" max="10" />
                            <span asp-validation-for="Nota.nota1" class="text-danger" style="font-size: 0.8125rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Nota.nota2" class="form-label">Nota 2 (30%)</label>
                            <input asp-for="Nota.nota2" class="form-control nota-input" type="number" step="0.01" min="0" max="10" />
                            <span asp-validation-for="Nota.nota2" class="text-danger" style="font-size: 0.8125rem;"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Nota.nota3" class="form-label">Nota 3 (40%)</label>
                            <input asp-for="Nota.nota3" class="form-control nota-input" type="number" step="0.01" min="0" max="10" />
                            <span asp-validation-for="Nota.nota3" class="text-danger" style="font-size: 0.8125rem;"></span>
                        </div>
                    </div>

                    <!-- Real-time preview -->
                    <div id="gradePreview" class="rules-panel mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span style="font-size: 0.875rem; font-weight: 500; color: var(--fg-secondary);">
                                <i class="bi bi-calculator"></i> Promedio estimado:
                            </span>
                            <span id="previewValue" class="font-mono" style="font-size: 1.125rem; font-weight: 700;">@Model.Nota.promedio.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span style="font-size: 0.875rem; font-weight: 500; color: var(--fg-secondary);">Estado:</span>
                            <span id="previewStatus" class="badge-status @(Model.Nota.estado == "Aprobado" ? "approved" : "failed")">
                                <i class="bi @(Model.Nota.estado == "Aprobado" ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                @Model.Nota.estado
                            </span>
                        </div>
                    </div>

                    <div style="font-size: 0.8125rem; color: var(--fg-muted); margin-bottom: var(--space-4);">
                        <i class="bi bi-info-circle"></i>
                        Ponderacion: N1 (30%) + N2 (30%) + N3 (40%). Aprobado si promedio &ge; 7.
                        <br />
                        <i class="bi bi-clock"></i>
                        Registrado el @Model.Nota.fechaRegistro.ToString("dd/MM/yyyy") — editable hasta 7 dias despues.
                    </div>

                    <div class="d-flex gap-2 pt-2">
                        <button type="submit" class="btn-brand">
                            <i class="bi bi-check-lg"></i> Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn-ghost">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
