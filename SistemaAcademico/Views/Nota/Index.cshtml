@model IEnumerable<Nota>
@{
    ViewData["Title"] = "Notas";
}

@if (TempData["Mensaje"] != null)
{
    <div class="sa-alert success" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["Mensaje"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="sa-alert danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-header">
    <div class="page-header-left">
        <div class="page-header-icon success">
            <i class="bi bi-clipboard-data-fill"></i>
        </div>
        <div>
            <nav class="breadcrumb-nav">
                <a asp-controller="Home" asp-action="Index">Inicio</a>
                <span class="separator">/</span>
                <span>Notas</span>
            </nav>
            <h1 class="page-title">Calificaciones</h1>
        </div>
    </div>
    <a asp-action="Create" class="btn-brand">
        <i class="bi bi-plus-lg"></i> Registrar Nota
    </a>
</div>

<div class="sa-card">
    <div class="sa-card-header">
        <span style="font-size: 0.8125rem; color: var(--fg-tertiary); font-weight: 500;">
            @Model.Count() registro(s)
        </span>
        <div class="search-bar">
            <i class="bi bi-search search-icon"></i>
            <input type="text" class="form-control" placeholder="Buscar por estudiante o curso..." data-table-search="notasTable" />
        </div>
    </div>
    <div class="sa-card-body no-padding">
        @if (Model.Any())
        {
            <div class="sa-table-wrapper">
                <table class="sa-table" id="notasTable">
                    <thead>
                        <tr>
                            <th style="width: 60px;">#</th>
                            <th>Estudiante</th>
                            <th>Curso</th>
                            <th style="text-align:center;">N1 (30%)</th>
                            <th style="text-align:center;">N2 (30%)</th>
                            <th style="text-align:center;">N3 (40%)</th>
                            <th style="text-align:center;">Promedio</th>
                            <th style="text-align:center;">Estado</th>
                            <th>Registro</th>
                            <th style="width: 120px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="col-id">@item.id_nota</td>
                                <td class="col-primary">@item.Matricula?.Estudiante?.nombreEstudiante</td>
                                <td>@item.Matricula?.Curso?.nombreCurso</td>
                                <td class="col-mono" style="text-align:center;">@item.nota1.ToString("F2")</td>
                                <td class="col-mono" style="text-align:center;">@item.nota2.ToString("F2")</td>
                                <td class="col-mono" style="text-align:center;">@item.nota3.ToString("F2")</td>
                                <td style="text-align:center;">
                                    <strong class="@(item.promedio >= 7 ? "grade-high" : "grade-low") font-mono">
                                        @item.promedio.ToString("F2")
                                    </strong>
                                </td>
                                <td style="text-align:center;">
                                    <span class="badge-status @(item.estado == "Aprobado" ? "approved" : "failed")">
                                        <i class="bi @(item.estado == "Aprobado" ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                        @item.estado
                                    </span>
                                </td>
                                <td class="col-mono" style="font-size: 0.8125rem;">@item.fechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="action-group">
                                        <a asp-action="Edit" asp-route-id="@item.id_nota" class="btn-action edit" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.id_nota" class="btn-action view" title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.id_nota" class="btn-action delete" title="Eliminar">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-clipboard-data"></i>
                <div class="empty-title">No hay notas registradas</div>
                <p class="empty-desc">Comienza registrando la primera calificacion.</p>
                <a asp-action="Create" class="btn-brand">
                    <i class="bi bi-plus-lg"></i> Registrar Nota
                </a>
            </div>
        }
    </div>
</div>
